# =============================================================================
# SETMS — Smart Emergency Traffic Management System
# Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# ---- Application ----
APP_ENV=development          # development | production
APP_DEBUG=true               # true in dev, false in prod
APP_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
APP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- JWT ----
JWT_SECRET_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_HEX_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Database (PostgreSQL for production) ----
DATABASE_URL=postgresql+asyncpg://setms_user:setms_pass@localhost:5432/setms_db

# ---- Database (SQLite fallback for local dev without Docker) ----
# Uncomment and comment out DATABASE_URL above to use SQLite locally
# DATABASE_URL=sqlite+aiosqlite:///./setms_dev.db

# ---- PostgreSQL Docker credentials ----
POSTGRES_DB=setms_db
POSTGRES_USER=setms_user
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Redis (for rate-limiting and caching) ----
REDIS_URL=redis://localhost:6379/0

# ---- MQTT Broker ----
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=setms_backend
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
MQTT_CLIENT_ID=setms-backend-001
MQTT_TOPIC_PREFIX=setms/v1
MQTT_USE_TLS=false
MQTT_CA_CERT_PATH=

# ---- AI Engine ----
AI_ENGINE_URL=http://localhost:8001
AI_ENGINE_API_KEY=CHANGE_ME_AI_ENGINE_KEY
AI_SIMULATION_MODE=true     # true = generate synthetic detections when no camera

# ---- YOLO / Computer Vision ----
YOLO_MODEL_PATH=weights/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.45
YOLO_DEVICE=cpu             # cpu | cuda | mps

# ---- Routing ----
ROUTING_PROVIDER=local      # local | osrm
OSRM_BASE_URL=http://router.project-osrm.org

# ---- Hospital Notifications ----
NOTIFY_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=setms@example.com

# ---- Seed / Development ----
SEED_ADMIN_EMAIL=admin@setms.local
SEED_ADMIN_PASSWORD=Admin1234!
SEED_OPERATOR_EMAIL=operator@setms.local
SEED_OPERATOR_PASSWORD=Operator1234!
SEED_DRIVER_EMAIL=driver@setms.local
SEED_DRIVER_PASSWORD=Driver1234!
SEED_HOSPITAL_EMAIL=hospital@setms.local
SEED_HOSPITAL_PASSWORD=Hospital1234!

# ---- Logging ----
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json             # json | text
